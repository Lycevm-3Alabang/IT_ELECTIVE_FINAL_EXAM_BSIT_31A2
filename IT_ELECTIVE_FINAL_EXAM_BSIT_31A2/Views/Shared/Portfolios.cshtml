@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('ytSearch');
            var items = document.querySelectorAll('.yt-item');
            var count = document.getElementById('ytCount');
            var empty = document.getElementById('ytEmpty');

            function update() {
                var term = input.value.trim().toLowerCase();
                var shown = 0;
                items.forEach(function (item) {
                    var name = item.querySelector('.yt-name').textContent.toLowerCase();
                    var match = name.indexOf(term) !== -1;
                    item.classList.toggle('d-none', !match);
                    if (match) shown++;
                });
                count.textContent = 'Showing ' + shown + ' of ' + items.length + ' portfolios';
                empty.classList.toggle('d-none', shown !== 0);
            }

            input.addEventListener('input', update);
            update();
        })();
    </script>
}
