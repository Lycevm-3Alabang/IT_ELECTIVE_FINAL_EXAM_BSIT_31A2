@model List<IT_ELECTIVE_FINAL_EXAM_BSIT_31A2.Models.MagnayonProject>

@{
    Layout = null;
    ViewData["Title"] = "Stephen Rhane L. Magnayon - Portfolio";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- custom fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&display=swap" rel="stylesheet">

    <!-- your exact custom styling scoped to this page -->
    <style>
        body {
            background: #a62a56;
            font-family: 'Comfortaa', sans-serif;
            overflow-x: hidden;
            color: #ffe6f0;
        }

        .bgscene {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            perspective: 800px;
            perspective-origin: 50% 50%;
            z-index: -2;
            overflow: hidden;
        }

        .floor, .ceiling {
            position: absolute;
            left: -50vw;
            width: 200vw;
            height: 100vh;
            background: repeating-conic-gradient(#a62a56 0% 25%, #7d163a 0% 50%) 50% / 240px 180px;
            animation: moving 4s infinite linear;
        }

        .floor {
            top: 66vh;
            transform-origin: top center;
            transform: rotateX(80deg);
            mask-image: linear-gradient(to bottom, transparent 0%, black 40%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 40%);
        }

        .ceiling {
            bottom: 66vh;
            transform-origin: bottom center;
            transform: rotateX(-80deg);
            mask-image: linear-gradient(to top, transparent 0%, black 40%);
            -webkit-mask-image: linear-gradient(to top, transparent 0%, black 40%);
        }

        @@keyframes moving {
            0% {
                background-position: 0% 0%;
            }

            100% {
                background-position: 240px 0%;
            }
        }

        /* scrollbar styling */
        ::-webkit-scrollbar {
            width: 20px;
        }

        ::-webkit-scrollbar-track {
            margin: 10px 4px;
            background: #852037;
            border-radius: 16px;
        }

        ::-webkit-scrollbar-thumb {
            background: #de5289;
            border-radius: 16px;
        }

        .main-container {
            color: #ffe6f0;
            position: relative;
        }

        .main-box {
            border-style: solid;
            border-color: #ffe6f0;
            border-width: 5px;
            border-radius: 8px;
            padding: 24px;
            color: #ffe6f0;
            background-color: #9e2957;
        }

        .main-heading {
            font-family: 'Comfortaa', sans-serif;
            font-weight: bold;
            text-align: center;
        }

        .main-aboutblockleft, .main-aboutblockright {
            background-color: #851b44;
            padding: 20px;
            border-radius: 14px;
            text-align: left;
            transition: all 0.25s ease-in-out;
        }

            .main-aboutblockleft h2, .main-aboutblockright h2 {
                text-align: center;
                transition: all 0.25s ease-in-out;
                font-size: 1.5em;
                margin-bottom: 12px;
            }

            .main-aboutblockleft:hover, .main-aboutblockright:hover {
                transform: scale(1.02);
            }

                .main-aboutblockleft:hover h2, .main-aboutblockright:hover h2 {
                    font-weight: bolder;
                }

        /* buttons owo */
        .main-socialsbutton {
            display: inline-block;
            background-color: #de5289;
            padding: 10px 18px;
            border-style: solid;
            border-color: #ffe6f0;
            border-width: 4px;
            border-radius: 14px;
            color: #ffe6f0;
            font-size: 1.1em;
            font-weight: bold;
            text-align: center;
            transition: background-color 0.2s ease, color 0.2s ease, border-radius 0.2s ease, transform 0.2s ease;
            cursor: pointer;
        }

            .main-socialsbutton:hover {
                background-color: #ffe6f0;
                color: #852037;
                border-radius: 20px;
                transform: scale(1.05);
            }

            .main-socialsbutton:active {
                background-color: #de5289;
                border-color: #852037;
                color: #ffe6f0;
            }

        .main-socialsgrid {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            align-items: center;
        }

            .main-socialsgrid .main-socialsbutton {
                min-width: 150px;
            }

        /* Centered 900px container */
        .site-wrapper {
            max-width: 900px;
            margin: 0 auto;
            width: 100%;
        }

        .main-wrapper {
            width: 100%;
            color: #ffe6f0;
            position: relative;
        }

        .card-img-top {
            height: 180px;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <!-- fixed background scene -->
    <div class="bgscene">
        <div class="ceiling"></div>
        <div class="floor"></div>
    </div>

    <div class="site-wrapper py-5 px-3">
        <main class="main-wrapper">

            <!-- home section -->
            <div class="main-box mb-5" id="home">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center">
                        <img src="~/images/magnayon/holymolytitsme.webp" alt="Look, it's me! owo" class="img-fluid rounded-circle mb-3 border border-4 border-light" />
                    </div>
                    <div class="col-md-8">
                        <h1 class="main-heading mb-2">Stephen Rhane L. Magnayon</h1>
                        <h3 class="mb-3 text-light">Artist, Writer, Hobbyist Game Developer</h3>
                        <p class="fs-5">
                            HAI! I'm a SEAsia-based Creative who just wants to get by, enjoy my furry-ish work! OwO
                        </p>
                        <div class="d-flex flex-wrap gap-3 mt-4">
                            <a href="#projects" class="main-socialsbutton text-decoration-none">View Projects</a>
                            <a href="#contact" class="main-socialsbutton text-decoration-none">Contact Me</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- about me section -->
            <div class="main-box mb-5" id="about">
                <h2 class="main-heading mb-4">About Me</h2>
                <div class="row g-4">
                    <!-- Box 1 -->
                    <div class="col-md-6">
                        <div class="main-aboutblockleft h-100">
                            <h2>Short Biography</h2>
                            <p>I do Arts and Literature primarily in the furry fandom! Which, I also happen to occasionally make games for whenever I <em>do</em> get the opportunity to, like in game jams and such!</p>
                        </div>
                    </div>

                    <!-- Box 2 -->
                    <div class="col-md-6">
                        <div class="main-aboutblockright h-100">
                            <h2>Educational Background</h2>
                            <p>I am currently pursuing college in Information Technology, focusing on web / game development!</p>
                        </div>
                    </div>

                    <!-- Box 3 -->
                    <div class="col-md-6">
                        <div class="main-aboutblockleft h-100">
                            <h2>Personal Interests</h2>
                            <p>I enjoy having gaming and reading stories as my pastime, they are much more important than people make them out to be! xP</p><br />
                            <p>Some examples of games I enjoy playing are Balatro, Binding of Isaac, Helldivers II, Antivirus Simulator 2003</p>
                        </div>
                    </div>

                    <!-- Box 4 -->
                    <div class="col-md-6">
                        <div class="main-aboutblockright h-100">
                            <h2>Primary Goal</h2>
                            <p>My primary goal, outside of making a living with my stories, is just sharing them to begin with! The idea of being able to tap into people's emotions with a beautiful, maybe even life-changing story is one that I hope to achieve one day.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- skills section -->
            <div class="main-box mb-5" id="skills">
                <h2 class="main-heading mb-4">Skills</h2>
                <div class="row g-4 justify-content-center">
                    <!-- programming languages -->
                    <div class="col-md-4">
                        <div class="card bg-transparent border-light border-3 h-100" style="background-color: #851b44 !important;">
                            <div class="card-body text-center text-white">
                                <h5 class="card-title fw-bold">Programming Languages</h5>
                                <hr />
                                <p class="card-text">Python (Ren'py), Twine (Harlowe & Sugarcube), GDScript</p>
                            </div>
                        </div>
                    </div>

                    <!-- web technologies -->
                    <div class="col-md-4">
                        <div class="card bg-transparent border-light border-3 h-100" style="background-color: #851b44 !important;">
                            <div class="card-body text-center text-white">
                                <h5 class="card-title fw-bold">Web Technologies</h5>
                                <hr />
                                <p class="card-text">ASP.NET Core MVC, HTML, CSS</p>
                            </div>
                        </div>
                    </div>

                    <!-- development tools -->
                    <div class="col-md-4">
                        <div class="card bg-transparent border-light border-3 h-100" style="background-color: #851b44 !important;">
                            <div class="card-body text-center text-white">
                                <h5 class="card-title fw-bold">Development Tools</h5>
                                <hr />
                                <p class="card-text">Visual Studio, Git, GitHub, VS Code</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- projects section (dynamically loaded from model) -->
            <div class="main-box mb-5" id="projects">
                <h2 class="main-heading mb-4">Projects</h2>
                <div class="row g-4">
                    @if (Model != null)
                    {
                        @foreach (var project in Model)
                        {
                            <div class="col-md-4">
                                <div class="card border-light border-3 h-100" style="background-color: #851b44;">
                                    <img src="@Url.Content(project.ImageUrl)" class="card-img-top p-2 rounded" alt="@project.Title">
                                    <div class="card-body text-center text-white d-flex flex-column">
                                        <h5 class="card-title fw-bold">@project.Title</h5>
                                        <p class="card-text flex-grow-1">@project.Description</p>
                                        <div class="mb-3">
                                            <small class="fw-bold" style="color: #f7a6b7;">@project.Technologies</small>
                                        </div>
                                        <a href="@project.ProjectUrl" target="_blank" class="main-socialsbutton text-decoration-none mt-auto">View Details</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- contact section -->
            <div class="main-box mb-3" id="contact">
                <h2 class="main-heading mb-4">Contact Me</h2>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="main-aboutblockleft h-100 text-center d-flex flex-column justify-content-center">
                            <h2>Email Address</h2>
                            <p class="fs-6 mb-0">bluberrii.jaminajar@gmail.com</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="main-aboutblockright h-100 text-center d-flex flex-column justify-content-center">
                            <h2>Mobile Number</h2>
                            <p class="fs-5 mb-0">+63 945 499 6557</p>
                        </div>
                    </div>
                </div>

                <div class="main-socialsgrid mb-4">
                    <a href="https://github.com/yuuworks" class="main-socialsbutton text-decoration-none">GitHub</a>
                </div>

                <div class="text-center mt-5 mb-2">
                    <a href="#" class="main-socialsbutton text-decoration-none px-5 py-3 fs-5">Download Resume (Placeholder)</a>
                </div>
            </div>

        </main>
    </div>

    <!-- bootstrap js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>